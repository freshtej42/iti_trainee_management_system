rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isDemoRecord(docId, data) {
      return docId.matches('^(demo-|att-demo-|disp-demo-).*') ||
        (data != null && data.instructor_id == 'guest-demo-instructor');
    }

    // Instructors: Read allowed; demo guest instructor cannot be created, updated, or deleted
    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if instructorId != 'guest-demo-instructor' &&
        (request.resource == null || request.resource.data.id != 'guest-demo-instructor');
    }

    // Trainees: Demo trainees can never be written or deleted in production database
    match /trainees/{traineeId} {
      allow read: if true;
      allow write: if !traineeId.matches('^demo-.*') &&
        (request.resource == null || request.resource.data.instructor_id != 'guest-demo-instructor');
    }

    // Attendance Records: Demo attendance records are strictly read-only / blocked from cloud write
    match /attendance_records/{recordId} {
      allow read: if true;
      allow write: if !recordId.matches('^(demo-|att-demo-).*') &&
        (request.resource == null || request.resource.data.instructor_id != 'guest-demo-instructor');
    }

    // Letter Templates: Preset templates and demo templates cannot be overwritten
    match /letter_templates/{templateId} {
      allow read: if true;
      allow write: if (request.resource == null || request.resource.data.instructor_id != 'guest-demo-instructor');
    }

    // Dispatch Logs: Demo dispatch records cannot be modified or added to production logs
    match /dispatch_logs/{logId} {
      allow read: if true;
      allow write: if !logId.matches('^disp-demo-.*') &&
        (request.resource == null || request.resource.data.instructor_id != 'guest-demo-instructor');
    }

    // System Settings (Super Admin configuration & UPI)
    match /system_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
